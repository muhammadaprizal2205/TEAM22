  <script>
    document.querySelectorAll('.pill').forEach(button => {
      button.addEventListener('click', () => {
        const chatBody = document.querySelector('.chat-body');
        const msg = document.createElement('div');
        msg.className = 'msg user';
        msg.textContent = button.textContent;
        chatBody.appendChild(msg);

        const response = document.createElement('div');
        response.className = 'msg bot';

        const q = button.textContent.toLowerCase();
        if (q.includes('contoh')) {
          response.textContent = 'Contoh diakronik: perkembangan perjuangan kemerdekaan Indonesia dari 1945 hingga 1949. Contoh sinkronik: kondisi Indonesia pada masa awal kemerdekaan yang mencakup politik, ekonomi, sosial, dan budaya.';
        } else if (q.includes('kuis')) {
          response.textContent = 'Berikut contoh kuis: “Apa yang dimaksud dengan berpikir diakronik?” Jawabannya: melihat perubahan peristiwa dalam rentang waktu.';
        } else {
          response.textContent = 'Sinkronik adalah pendekatan yang menelaah suatu peristiwa pada masa tertentu secara menyeluruh, dengan melihat berbagai aspek seperti politik, ekonomi, sosial, budaya, dan agama.';
        }

        chatBody.appendChild(response);
        chatBody.scrollTop = chatBody.scrollHeight;
      });
    });

    document.querySelectorAll('.option').forEach(option => {
      option.addEventListener('click', () => {
        const answerBox = option.parentElement.parentElement.querySelector('.answer');
        if (answerBox) answerBox.style.display = 'block';
      });
    });
  </script>
