                    </div>
                    <div class="bg-indigo-50 dark:bg-slate-900 p-6 rounded-2xl border border-indigo-200 dark:border-slate-700 text-center">
                        <span class="text-3xl font-extrabold text-indigo-700 dark:text-indigo-400" id="stat-quiz-takers">4</span>
                        <p class="text-xs font-semibold text-slate-600 dark:text-slate-400 mt-1">Peserta Kuis Selesai</p>
                    </div>
                    <div class="bg-emerald-50 dark:bg-slate-900 p-6 rounded-2xl border border-emerald-200 dark:border-slate-700 text-center">
                        <span class="text-3xl font-extrabold text-emerald-700 dark:text-emerald-400">Aktif</span>
