                <!-- Admin Action Management -->
                <div class="space-y-6">
                    <h3 class="font-bold text-slate-900 dark:text-white text-base">Kelola Materi & Pengumuman Kelas</h3>
                    <div class="flex gap-4">
                        <input type="text" id="admin-announcement" placeholder="Tulis pengumuman baru untuk siswa..." class="flex-grow px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 text-sm text-slate-900 dark:text-white">
