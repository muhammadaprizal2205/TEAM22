    <!-- Footer -->
    <footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 mt-12 py-8 text-center text-xs text-slate-500 transition-colors duration-300">
        <div class="max-w-7xl mx-auto px-4 space-y-2">
            <p class="font-medium text-slate-700 dark:text-slate-300">LMS Sejarah: Diakronik & Sinkronik</p>
            <p>&copy; 2026 Dr. Budi Sejarah, M.Pd. | Dirancang untuk GitHub Pages.</p>
        </div>
    </footer>

    <!-- JavaScript Application Logic -->
    <script>
        // --- Dark Mode Controller ---
        function toggleDarkMode() {
            const html = document.documentElement;
            const themeIcon = document.getElementById('theme-icon');
            html.classList.toggle('dark');
            if (html.classList.contains('dark')) {
                themeIcon.className = 'fa-solid fa-sun text-base text-amber-400';
                localStorage.setItem('theme', 'dark');
            } else {
                themeIcon.className = 'fa-solid fa-moon text-base text-slate-600';
                localStorage.setItem('theme', 'light');
            }
        }

        // Initialize Theme from localStorage
        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark');
            document.getElementById('theme-icon').className = 'fa-solid fa-sun text-base text-amber-400';
        }

        // --- Role-Based Login System ---
        let currentUser = {
            name: "Rian Anggara",
            role: "siswa"
        };

        function handleLogin() {
            const usernameInput = document.getElementById('login-username').value.trim();
            const roleSelect = document.getElementById('login-role').value;

            if (usernameInput) {
                currentUser.name = usernameInput;
            } else {
                currentUser.name = roleSelect === 'guru' ? 'Dr. Budi Sejarah, M.Pd.' : 'Rian Anggara';
            }
            currentUser.role = roleSelect;

            // Update UI Badge
            document.getElementById('user-badge-name').textContent = currentUser.name;
            document.getElementById('user-badge-role').textContent = currentUser.role === 'guru' ? 'Guru / Admin' : 'Peserta Didik';
            document.getElementById('user-badge-avatar').src = currentUser.role === 'guru' 
                ? 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=150' 
                : 'https://placehold.co/100x100/b45309/ffffff?text=R';

            // Show/Hide Admin Tab
            const adminBtn = document.getElementById('nav-admin-btn');
            const mobileAdminBtn = document.getElementById('mobile-admin-btn');
            if (currentUser.role === 'guru') {
                adminBtn.classList.remove('hidden');
                mobileAdminBtn.classList.remove('hidden');
                showToast('Selamat datang, Guru! Panel Admin aktif.', 'success');
            } else {
                adminBtn.classList.add('hidden');
                mobileAdminBtn.classList.add('hidden');
                showToast(`Selamat datang, ${currentUser.name}!`, 'success');
            }

            // Close Modal
            document.getElementById('login-modal').classList.add('hidden');
        }

        // --- Navigation Tabs ---
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-amber-700', 'bg-amber-50', 'dark:bg-slate-800', 'font-bold');
                if(btn.getAttribute('data-target') === tabId) {
                    btn.classList.add('text-amber-700', 'bg-amber-50', 'dark:bg-slate-800', 'font-bold');
                }
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        // --- Toast Notification ---
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const msgEl = document.getElementById('toast-message');
            const iconEl = document.getElementById('toast-icon');

            msgEl.textContent = message;
            toast.className = `fixed top-5 right-5 z-50 transform transition-transform duration-300 text-white px-6 py-3 rounded-xl shadow-2xl flex items-center gap-3 ${type === 'success' ? 'bg-emerald-600' : 'bg-amber-600'}`;
            iconEl.className = type === 'success' ? 'fa-solid fa-circle-check text-xl' : 'fa-solid fa-circle-info text-xl';

            toast.classList.remove('translate-x-full');
            setTimeout(() => { toast.classList.add('translate-x-full'); }, 3500);
        }

        // --- Camera Attendance ---
        let attendanceRecords = [];
        async function startCamera() {
            const video = document.getElementById('camera-feed');
            const placeholder = document.getElementById('camera-placeholder');
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: true });
                video.srcObject = stream;
                video.classList.remove('hidden');
                placeholder.classList.add('hidden');
                document.getElementById('btn-capture').removeAttribute('disabled');
                showToast('Kamera aktif!', 'success');
            } catch (err) {
                placeholder.innerHTML = `<i class="fa-solid fa-face-smile text-5xl text-amber-500 mb-2"></i><p class="text-xs text-amber-200">Mode Simulasi Kamera Aktif (Face Captured)</p>`;
                document.getElementById('btn-capture').removeAttribute('disabled');
                showToast('Simulasi kamera siap!', 'info');
            }
        }

        function captureAttendance() {
            const name = document.getElementById('absent-name').value.trim() || currentUser.name;
            const cls = document.getElementById('absent-class').value;
            const time = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });

            attendanceRecords.unshift({ time, name, className: cls, status: 'Hadir' });
            renderAttendanceList();
            showToast(`Absensi ${name} berhasil dicatat!`, 'success');
        }

        function renderAttendanceList() {
            const list = document.getElementById('attendance-list');
            document.getElementById('attendance-count').textContent = `${attendanceRecords.length} Siswa Hadir`;
            document.getElementById('stat-attendance-count').textContent = attendanceRecords.length;

            if(attendanceRecords.length === 0) {
                list.innerHTML = `<tr class="text-slate-400 text-center"><td colspan="4" class="p-4 italic">Belum ada data absensi.</td></tr>`;
                return;
            }
            let html = '';
            attendanceRecords.forEach(r => {
                html += `<tr class="hover:bg-slate-50 dark:hover:bg-slate-900 transition"><td class="p-3">${r.time}</td><td class="p-3 font-bold">${r.name}</td><td class="p-3">${r.className}</td><td class="p-3 text-center"><span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full text-[10px]">Hadir</span></td></tr>`;
            });
            list.innerHTML = html;
        }

        // --- Discussion ---
        function postDiscussion() {
            const author = document.getElementById('disc-author').value.trim() || currentUser.name;
            const topic = document.getElementById('disc-topic').value;
            const content = document.getElementById('disc-content').value.trim();

            if(!content) { showToast('Tuliskan isi diskusi!', 'error'); return; }

            const feed = document.getElementById('discussion-feed');
            feed.insertAdjacentHTML('afterbegin', `
                <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-3">
                    <div class="flex items-center justify-between"><h4 class="font-bold text-sm text-slate-900 dark:text-white">${author}</h4><span class="text-xs text-slate-400">Baru saja</span></div>
                    <p class="text-sm text-slate-700 dark:text-slate-300">${content}</p>
                </div>
            `);
            document.getElementById('disc-content').value = '';
            showToast('Diskusi terkirim!', 'success');
        }

        // --- Quiz & Leaderboard ---
        const quizQuestions = [
            { question: "Cara berpikir sejarah yang memanjang dalam waktu (kronologis) disebut...", options: ["A. Sinkronik", "B. Diakronik", "C. Sosiologis", "D. Ruang"], answer: 1 },
            { question: "Analisis struktur sosial pada waktu tertentu secara meluas disebut...", options: ["A. Diakronik", "B. Sinkronik", "C. Diachronic", "D. Kronologi"], answer: 1 }
        ];
        let currQ = 0, answers = {}, leaderboard = [{ rank: 1, name: "Aurel Widya", score: 100 }];

        function renderQuiz() {
            const container = document.getElementById('quiz-container');
            const q = quizQuestions[currQ];
            let opts = '';
            q.options.forEach((opt, idx) => {
                opts += `<label class="flex items-center gap-3 p-4 rounded-xl border border-slate-200 dark:border-slate-700 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-900"><input type="radio" name="q" value="${idx}" ${answers[currQ]===idx?'checked':''} onclick="answers[currQ]=${idx}"><span>${opt}</span></label>`;
            });
            container.innerHTML = `<h3 class="font-bold text-base text-slate-900 dark:text-white">${currQ+1}. ${q.question}</h3><div class="space-y-2">${opts}</div>`;
            document.getElementById('quiz-progress').textContent = `Soal ${currQ+1} dari ${quizQuestions.length}`;
        }

        function nextQuizQuestion() {
            if(currQ < quizQuestions.length - 1) { currQ++; renderQuiz(); }
            else {
                let score = 100;
                leaderboard.push({ rank: 0, name: currentUser.name, score });
                leaderboard.sort((a,b)=>b.score-a.score);
                leaderboard.forEach((item, idx)=>item.rank=idx+1);
                renderLeaderboard();
                showToast(`Kuis Selesai! Skor Anda: ${score}`, 'success');
                currQ = 0; renderQuiz();
            }
        }
        function prevQuizQuestion() { if(currQ>0) { currQ--; renderQuiz(); } }

        function renderLeaderboard() {
            const list = document.getElementById('leaderboard-list');
            let html = '';
            leaderboard.forEach(item => {
                html += `<div class="flex items-center justify-between p-3 rounded-xl border border-slate-100 dark:border-slate-700"><div class="flex items-center gap-3"><div class="w-7 h-7 bg-amber-600 text-white rounded-full flex items-center justify-center font-bold text-xs">${item.rank}</div><span class="font-bold text-xs text-slate-900 dark:text-white">${item.name}</span></div><span class="font-extrabold text-xs text-amber-700">${item.score} Pts</span></div>`;
            });
            list.innerHTML = html;
        }

        // --- AI Virtual Tutor Chatbot ---
        function sendAIChat() {
            const input = document.getElementById('chat-input');
            const msgBox = document.getElementById('chat-messages');
            const txt = input.value.trim();
            if(!txt) return;

            msgBox.innerHTML += `<div class="flex items-start justify-end gap-3"><div class="bg-amber-700 text-white p-4 rounded-2xl shadow-sm max-w-lg text-sm">${txt}</div></div>`;
            input.value = '';

            setTimeout(() => {
                let reply = "Diakronik fokus pada proses dan urutan waktu (vertikal), sedangkan sinkronik fokus pada struktur dan kondisi dalam satu waktu tertentu (horizontal). Ada yang ingin ditanyakan lagi?";
                if(txt.toLowerCase().includes('contoh')) {
                    reply = "Contoh diakronik: Perang Diponegoro (1825-1830). Contoh sinkronik: Suasana sosial ekonomi Indonesia saat krisis moneter tahun 1998.";
                }
                msgBox.innerHTML += `<div class="flex items-start gap-3"><div class="w-8 h-8 rounded-full bg-amber-700 text-white flex items-center justify-center text-xs font-bold">AI</div><div class="bg-white dark:bg-slate-800 p-4 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 max-w-lg text-sm text-slate-700 dark:text-slate-300">${reply}</div></div>`;
                msgBox.scrollTop = msgBox.scrollHeight;
            }, 600);
        }

        function postAnnouncement() {
            const val = document.getElementById('admin-announcement').value;
            if(val) { showToast('Pengumuman kelas berhasil disiarkan!', 'success'); document.getElementById('admin-announcement').value = ''; }
        }

        window.onload = function() {
            renderQuiz();
            renderLeaderboard();
            renderAttendanceList();
        };
    </script>
</body>
</html>
