                    <div class="mt-8 pt-4 border-t border-slate-100 dark:border-slate-700 flex justify-between items-center">
                        <button id="quiz-prev-btn" onclick="prevQuizQuestion()" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-200 rounded-xl text-sm font-semibold disabled:opacity-40" disabled>Sebelumnya</button>
                        <button id="quiz-next-btn" onclick="nextQuizQuestion()" class="px-6 py-2 bg-amber-700 hover:bg-amber-800 text-white rounded-xl text-sm font-semibold transition">Selanjutnya</button>
