                <!-- Chat Input Footer -->
                <div class="p-4 bg-white dark:bg-slate-800 border-t border-slate-200 dark:border-slate-700 flex gap-3 items-center">
                    <input type="text" id="chat-input" placeholder="Tulis pertanyaan Anda di sini..." class="flex-grow px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-amber-600" onkeypress="if(event.key === 'Enter') sendAIChat()">
                    <button onclick="sendAIChat()" class="bg-amber-700 hover:bg-amber-800 text-white px-6 py-3 rounded-xl font-semibold text-sm transition shadow flex items-center gap-2">
                        <i class="fa-solid fa-paper-plane"></i> Kirim
